# Local environment — copy to .env and fill in values.
# NEVER commit the real .env file.

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_ENCRYPTION_KEY
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
# Execution retention: reduce or disable payload storage in production.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none

# ---------------------------------------------------------------------------
# Threat-intelligence providers
# These are placeholders for documentation. The exported workflow stores header
# values inline; prefer n8n Header Auth credentials instead.
# ---------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=REPLACE_WITH_VIRUSTOTAL_API_KEY
ABUSEIPDB_API_KEY=REPLACE_WITH_ABUSEIPDB_API_KEY
OTX_API_KEY=REPLACE_WITH_OTX_API_KEY
GREYNOISE_API_KEY=REPLACE_WITH_GREYNOISE_API_KEY
THREATFOX_AUTH_KEY=REPLACE_WITH_THREATFOX_AUTH_KEY
LEAKIX_API_KEY=REPLACE_WITH_LEAKIX_API_KEY

# ---------------------------------------------------------------------------
# Laya / Hermes triage engine
# The exported workflow calls POST /api/triage over plain HTTP with no HMAC
# header. LAYA_HMAC_SECRET is therefore NOT used by this export. Add HMAC only
# after the engine's signing contract is documented and verified.
# ---------------------------------------------------------------------------
LAYA_BASE_URL=http://REPLACE_WITH_LAYA_HOST:9999
LAYA_TRIAGE_PATH=/api/triage
LAYA_API_TOKEN=REPLACE_WITH_LAYA_API_TOKEN_IF_REQUIRED
LAYA_HMAC_SECRET=REPLACE_WITH_LAYA_HMAC_SECRET_IF_REQUIRED
LAYA_REQUEST_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# DFIR-IRIS
# ---------------------------------------------------------------------------
DFIR_IRIS_URL=https://REPLACE_WITH_IRIS_HOST
DFIR_IRIS_API_KEY=REPLACE_WITH_DFIR_IRIS_API_TOKEN
DFIR_IRIS_CUSTOMER_ID=1

# ---------------------------------------------------------------------------
# FortiGate
# ---------------------------------------------------------------------------
FORTIGATE_HOST=REPLACE_WITH_FORTIGATE_HOST
FORTIGATE_PORT=11443
FORTIGATE_API_TOKEN=REPLACE_WITH_FORTIGATE_API_TOKEN
FORTIGATE_VDOM=root

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_DISCORD_WEBHOOK_ID/REPLACE_WITH_DISCORD_WEBHOOK_TOKEN
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID
SLACK_BOT_TOKEN=REPLACE_WITH_SLACK_BOT_TOKEN
SLACK_CHANNEL=#security-reports
